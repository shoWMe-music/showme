# Local MCP config contains a secret token — never commit it.
# When the repo goes to git, either keep this ignore, or switch .mcp.json
# back to the ${MOLLIE_API_OAUTH_ORG_TOKEN} env-var form and un-ignore it.
.mcp.json

# Secrets / env
.env
.env.local
*.local

# Dependencies & build output
node_modules
dist
.turbo
coverage
*.tsbuildinfo

# OS
.DS_Store

# design-sync (claude.ai/design) — transient build/verification artifacts.
# The durable set under .design-sync/ (config.json, NOTES.md, conventions.md, previews/, overrides/) IS committed.
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.design-sync/reference-organic/
.design-sync/*.log
.design-sync/upload-*.json
.ds-sync/
ds-bundle/

# Firebase emulator artifacts
firebase-debug.log
firebase-*-debug.log
.firebase/

# Extracted Claude Design export (served by pnpm design:ref)
.design-reference/

# Generated by a local run, never committed — and, because biome reads this file,
# never linted either. Each of these was showing up as a lint error on a clean
# checkout, which is exactly the noise that teaches people to ignore CI.
# (comments go on their OWN line — .gitignore has no trailing-comment syntax, so
# `pattern  # note` is a pattern that literally contains "  # note" and matches
# nothing.)
# Playwright storage state, rewritten by auth.setup.ts on every local e2e run
apps/web/tests/.auth/
# Terraform's provider/module cache (the .terraform.lock.hcl IS committed)
**/.terraform/
# browser-automation scratch output
.playwright-mcp/
