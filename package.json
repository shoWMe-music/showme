{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:functions": "npm --prefix functions run build",
    "watch:functions": "npm --prefix functions run watch",
    "dev:emulators": "npm run build:functions && concurrently -k -n emulators,seed -c cyan,magenta \"firebase emulators:start --project showme-local\" \"sh -c 'node scripts/wait-for-emulators.mjs && npm run seed && tail -f /dev/null'\"",
    "predev:local": "node -e \"require('fs').mkdirSync('emulator-data',{recursive:true})\"",
    "dev:local": "npm run build:functions && concurrently -k -n tsc,emulators,web,seed -c yellow,cyan,green,magenta \"npm run watch:functions\" \"firebase emulators:start --project showme-local --import=./emulator-data --export-on-exit=./emulator-data\" \"tsx server.ts\" \"sh -c 'node scripts/wait-for-emulators.mjs && npm run seed && tail -f /dev/null'\"",
    "emulators": "npm run dev:emulators",
    "seed": "tsx scripts/seed.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:ssr": "MODE=ssr vite build --mode ssr",
    "build:all": "vite build && npm run build:ssr && node scripts/build-ssr-template.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --project=app",
    "test:e2e:all": "npx playwright test",
    "deploy": "bash -c 'source ~/.nvm/nvm.sh && nvm use 22 >/dev/null && firebase deploy --only hosting,functions'"
  },
