# SSE service container for Cloud Run. Mirrors the API's `Dockerfile`; both live at
# the repo ROOT so the build context is the whole workspace (the esbuild bundle pulls
# in the @showme/* TS source).
#
# `gcloud run deploy --source .` always picks the root `Dockerfile` (the API), so this
# service builds and pushes an image explicitly:
#   docker build -f Dockerfile.stream -t <REGION>-docker.pkg.dev/<PROJECT>/<REPO>/showme-stream .
#   docker push  <REGION>-docker.pkg.dev/<PROJECT>/<REPO>/showme-stream
#   gcloud run deploy showme-stream --image <same> …      (see docs/deploy-stream.md)
# One self-contained dist/server.mjs; runtime is just Node + that file.
# syntax=docker/dockerfile:1

FROM node:22-slim AS build
RUN corepack enable
WORKDIR /repo
# Copy the whole workspace (the repo-root .dockerignore keeps node_modules, builds,
# secrets and test junk out) so pnpm can resolve the full workspace graph, then
# install just what the stream service needs and bundle it.
COPY . .
RUN pnpm install --frozen-lockfile --filter @showme/stream...
RUN pnpm --filter @showme/stream build

FROM node:22-slim AS runtime
ENV NODE_ENV=production
# Cloud Run injects PORT (defaults to 8080); HOST defaults to 0.0.0.0 in config.ts.
WORKDIR /app
COPY --from=build /repo/apps/stream/dist/server.mjs ./server.mjs
EXPOSE 8080
# Run as the non-root node user baked into the image.
USER node
CMD ["node", "server.mjs"]
