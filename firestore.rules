rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    /** True if the signed-in user has a member doc under this profile. */
    function isProfileMember(profileId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/profiles/$(profileId)/members/$(request.auth.uid));
    }

    /** True if the signed-in user is owner or admin on this profile. */
    function isProfileAdmin(profileId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/profiles/$(profileId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(profileId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }

    /**
     * A user has access to an event if:
     *  - their uid is in the denormalized accessUids array, OR
     *  - they are the original owner_uid (legacy events created before
     *    accessUids existed, plus the in-memory fallback query in fetchEvents), OR
     *  - they are a member of the host profile (covers the host profile before
     *    accessUids is populated, e.g. immediately after event creation), OR
     *  - they are a member of the performer profile.
     *
     * Uses get(field, default) throughout to avoid null-value errors in list queries.
     */
    function hasEventAccess(ev) {
      return isAuthed() && (
        uid() in ev.get('accessUids', [])
        || uid() == ev.get('owner_uid', '')
        || (ev.get('hostProfileId', '') is string && ev.get('hostProfileId', '') != ''
            && isProfileMember(ev.get('hostProfileId', '')))
        || (ev.get('performerProfileId', '') is string && ev.get('performerProfileId', '') != ''
            && isProfileMember(ev.get('performerProfileId', '')))
        // Legacy: participant_uids kept during transition
        || uid() in ev.get('participant_uids', [])
      );
    }

    /** Host profile admin — can manage collaborators, participants, and delete. */
    function isHostAdmin(ev) {
      return isAuthed()
        && ev.keys().hasAll(['hostProfileId'])
        && ev.hostProfileId is string
        && ev.hostProfileId != ''
        && isProfileAdmin(ev.hostProfileId);
    }

    /**
     * Permission-gated write access for event + subcollections.
     *
     * Tiers:
     *   - host profile members are always admin (write everywhere)
     *   - direct collaborators write when their uid is in editorUids
     *     (admin + editor permissions write here; view_only stays out)
     *
     * Legacy fallback: events that pre-date the permission rollout have no
     * editorUids field at all. To avoid locking those users out, we treat
     * missing editorUids as "any access-uid may edit" (the previous rule).
     * Once a new invite flows through, editorUids is populated and the gate
     * tightens automatically.
     */
    function hasEventEditPermission(ev) {
      return isAuthed() && (
        isHostAdmin(ev)
        || uid() in ev.get('editorUids', [])
        || (
          !ev.keys().hasAll(['editorUids'])
          && hasEventAccess(ev)
        )
      );
    }

    function canEditEvent(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId))
        && hasEventEditPermission(parentEvent(eventId));
    }

    /**
     * Authorization for collaborator-management writes (invite, edit
     * permission, remove). Two paths:
     *   - host profile members (implicit admin, never listed in adminUids)
     *   - uids listed in event.adminUids (non-host collab-admins)
     *
     * Legacy events that pre-date the permission rollout have no adminUids
     * field, so they fall through the array branch and only host members can
     * manage collaborators — matching today's behavior. The field gets
     * populated as soon as the first non-host admin is assigned.
     */
    function canManageEventCollaborators(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId))
        && isAuthed()
        && (
          isHostAdmin(parentEvent(eventId))
          || uid() in parentEvent(eventId).get('adminUids', [])
        );
    }

    /** Profiles whose role allows event creation. */
    function isEventHostProfileType(profileId) {
      return exists(/databases/$(database)/documents/profiles/$(profileId))
        && (
          (get(/databases/$(database)/documents/profiles/$(profileId)).data.keys().hasAll(['role'])
            && get(/databases/$(database)/documents/profiles/$(profileId)).data.role in ['venue', 'promoter', 'organizer', 'festival'])
          || (get(/databases/$(database)/documents/profiles/$(profileId)).data.keys().hasAll(['type'])
            && get(/databases/$(database)/documents/profiles/$(profileId)).data.type in ['venue', 'promoter', 'organizer', 'festival'])
        );
    }

    /** True iff the profile is performer-shaped (role or type == "performer" or legacy "artist"). */
    function isPerformerProfile(profileId) {
      return exists(/databases/$(database)/documents/profiles/$(profileId))
        && (
          get(/databases/$(database)/documents/profiles/$(profileId)).data.get('role', '') in ['performer', 'artist']
          || get(/databases/$(database)/documents/profiles/$(profileId)).data.get('type', '') in ['performer', 'artist']
        );
    }

    // ── Events ───────────────────────────────────────────────────────────────

    match /events/{eventId} {
      allow read: if
        // Public: published confirmed events (doc must exist)
        (resource != null && resource.data.get('published', false) == true && resource.data.get('eventStatus', '') == 'confirmed')
        // Authenticated: allow reads of non-existent docs (getDoc before create) or accessible docs
        || (isAuthed() && (resource == null || (resource.data is map && hasEventAccess(resource.data))));

      // Event cap (Free Operator: 60 confirmed events/year + 6 grace).
      // A blocked profile cannot create a new confirmed/concluded event nor
      // transition an existing one INTO confirmed/concluded. Once they've
      // upgraded or cancelled enough events, the trigger flips
      // `plans/{hostPid}.eventCapBlocked` back to false and the gate opens.
      function newStatusIsCounted() {
        return request.resource.data.get('eventStatus', '') in ['confirmed', 'concluded'];
      }
      function wouldBumpCapCounter() {
        return newStatusIsCounted()
          && (resource == null
              || !(resource.data.get('eventStatus', '') in ['confirmed', 'concluded']));
      }

      allow create: if
        isAuthed()
        && request.resource.data.keys().hasAll(['hostProfileId'])
        && request.resource.data.hostProfileId is string
        && request.resource.data.hostProfileId != ''
        && isProfileAdmin(request.resource.data.hostProfileId)
        && isEventHostProfileType(request.resource.data.hostProfileId)
        && (!wouldBumpCapCounter()
            || !profileIsCapBlocked(request.resource.data.hostProfileId));

      // While `pendingHostHandoff == true`, the event must stay in draft.
      // This closes the loophole where a performer (who owns the unclaimed
      // venue stub and is therefore host-admin) could push the event into
      // confirmed/concluded without the venue ever taking over — and without
      // a real plan doc on the stub, the cap gate wouldn't catch it.
      //
      // `claimInvitationCode` clears the flag atomically with the profile
      // transfer, after which the real venue host can promote the event
      // through the normal lifecycle.
      function handoffPendingButLeavingDraft() {
        return (resource.data.get('pendingHostHandoff', false) == true
                || request.resource.data.get('pendingHostHandoff', false) == true)
          && request.resource.data.get('eventStatus', '') != 'draft';
      }

      allow update: if
        isAuthed()
        && resource.data is map
        && hasEventEditPermission(resource.data)
        && !handoffPendingButLeavingDraft()
        && (!wouldBumpCapCounter()
            || !profileIsCapBlocked(resource.data.get('hostProfileId', '')));

      allow delete: if
        isAuthed()
        && resource.data is map
        && isHostAdmin(resource.data);
    }

    // ── Event subcollections: helper to get parent event ─────────────────────

    function parentEvent(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId))
        ? get(/databases/$(database)/documents/events/$(eventId)).data
        : {};
    }

    function canAccessEvent(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId))
        && isAuthed()
        && hasEventAccess(parentEvent(eventId));
    }

    function isEventHost(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId))
        && isAuthed()
        && isHostAdmin(parentEvent(eventId));
    }

    // ── Deal ─────────────────────────────────────────────────────────────────

    match /events/{eventId}/deal/{docId} {
      allow read: if canAccessEvent(eventId);
      allow write: if canEditEvent(eventId);
    }

    // ── Settlement ───────────────────────────────────────────────────────────

    match /events/{eventId}/settlement/{docId} {
      allow read: if canAccessEvent(eventId);
      allow write: if canEditEvent(eventId);
    }

    // ── Revenue ──────────────────────────────────────────────────────────────

    match /events/{eventId}/revenue/{docId} {
      allow read: if canAccessEvent(eventId);
      allow write: if canEditEvent(eventId);
    }

    // ── Settlement Activity ───────────────────────────────────────────────────

    match /events/{eventId}/activity/{activityId} {
      allow read: if canAccessEvent(eventId);
      allow create: if canEditEvent(eventId);
    }

    // ── Event Activity ────────────────────────────────────────────────────────

    match /events/{eventId}/event_activity/{activityId} {
      allow read: if canAccessEvent(eventId);
      allow create: if canEditEvent(eventId);
    }

    // ── Riders / Agreements / Crew / Schedule ────────────────────────────────
    //
    // Reads, creates, and updates are open to any event collaborator — the
    // autosave loops blindly re-upsert every doc on state change, so per-party
    // update gates would reject legitimate no-op merges.
    //
    // Deletes are restricted to the original creator (stamped at first write
    // by the upsert helpers in db.ts) or the event host.

    function canDeleteOwnedSubdoc(eventId) {
      return canEditEvent(eventId)
        && (
          isEventHost(eventId)
          || resource.data.createdByUid == uid()
        );
    }

    match /events/{eventId}/riders/{riderId} {
      allow read: if canAccessEvent(eventId);
      allow create, update: if canEditEvent(eventId);
      allow delete: if canDeleteOwnedSubdoc(eventId);
    }

    match /events/{eventId}/agreements/{agreementId} {
      allow read: if canAccessEvent(eventId);
      allow create, update: if canEditEvent(eventId);
      allow delete: if canDeleteOwnedSubdoc(eventId);
    }

    match /events/{eventId}/crew/{memberId} {
      allow read: if canAccessEvent(eventId);
      allow create, update: if canEditEvent(eventId);
      allow delete: if canDeleteOwnedSubdoc(eventId);
    }

    match /events/{eventId}/schedule/{itemId} {
      allow read: if canAccessEvent(eventId);
      allow create, update: if canEditEvent(eventId);
      allow delete: if canDeleteOwnedSubdoc(eventId);
    }

    // ── Participants (profiles invited to event) ──────────────────────────────

    match /events/{eventId}/participants/{profileId} {
      allow read: if canAccessEvent(eventId);
      allow write, delete: if isEventHost(eventId);
    }

    // ── Event metadata (proEstimate, proReporting, amenities, todos) ──────────
    // Shared meta docs (e.g. "main") are accessible to all event collaborators.
    // Profile-scoped todo docs (e.g. "todos_<profileId>") are restricted to
    // members of that profile (or the user if keyed by uid).

    match /events/{eventId}/meta/{docId} {
      allow read: if canAccessEvent(eventId)
        && (
          !docId.matches('todos_.*')
          || docId == ('todos_user_' + uid())
          || isProfileMember(docId[6:docId.size()])
        );
      allow write: if canEditEvent(eventId)
        && (
          // Non-todo docs: open to event editors
          !docId.matches('todos_.*')
          // todos_user_{uid}: only that user
          || docId == ('todos_user_' + uid())
          // todos_{profileId}: must be a member of that profile
          || isProfileMember(docId[6:docId.size()])
        );
    }

    // ── Budget per profile ────────────────────────────────────────────────────

    match /events/{eventId}/budgets/{profileId} {
      allow read: if
        canAccessEvent(eventId)
        && (
          (exists(/databases/$(database)/documents/profiles/$(profileId))
            && isProfileMember(profileId))
          || profileId == uid()
        );
      allow write: if
        canEditEvent(eventId)
        && (
          // Profile budget: only members of that profile
          (exists(/databases/$(database)/documents/profiles/$(profileId))
            && isProfileMember(profileId))
          // Personal budget: user keyed by their own uid (no profile)
          || profileId == uid()
        );
      allow delete: if isEventHost(eventId);
    }

    // ── Collaborators ─────────────────────────────────────────────────────────
    //
    // Granting the `admin` permission tier is a Pro feature (PDF Gate 3:
    // "Admin and team management on Pro"). For writes that set permission to
    // "admin", require the host profile's plan to be paid. Editor / view_only
    // moves remain free.
    //
    // The plan doc is read fresh — we deliberately do NOT use a custom claim
    // for plan so downgrades take effect immediately with no JWT staleness.

    function hostHasPaidPlan(eventId) {
      let hostPid = parentEvent(eventId).get('hostProfileId', '');
      return hostPid is string
        && hostPid != ''
        && exists(/databases/$(database)/documents/plans/$(hostPid))
        && get(/databases/$(database)/documents/plans/$(hostPid)).data.get('type', '') in ['operator_pro', 'artist_pro'];
    }

    /**
     * True when the host profile's plan has been flagged as event-cap blocked
     * by the `onEventWrittenMaintainCap` trigger (Free Operator over the 60+6
     * limit). The trigger updates `plans/{hostPid}.eventCapBlocked` after every
     * event status change so this read is always one doc, never an aggregation.
     */
    function profileIsCapBlocked(profileId) {
      return exists(/databases/$(database)/documents/plans/$(profileId))
        && get(/databases/$(database)/documents/plans/$(profileId)).data.get('eventCapBlocked', false) == true;
    }

    function permissionWriteIsAllowed(eventId) {
      // request.resource is the doc being written. delete ops have no
      // request.resource — skip the plan check then (the manage gate above
      // already authorizes the deletion).
      return !('permission' in request.resource.data.keys())
        || request.resource.data.permission != 'admin'
        || hostHasPaidPlan(eventId);
    }

    match /events/{eventId}/collaborators/{cid} {
      allow read: if canAccessEvent(eventId);
      allow create, update: if
        canManageEventCollaborators(eventId)
        && permissionWriteIsAllowed(eventId);
      allow delete: if canManageEventCollaborators(eventId);
    }

    // ── Messages ──────────────────────────────────────────────────────────────

    match /events/{eventId}/messages/{messageId} {
      allow read: if
        (parentEvent(eventId).published == true && parentEvent(eventId).eventStatus == 'confirmed')
        || canAccessEvent(eventId);

      allow create: if
        canEditEvent(eventId)
        && request.resource.data.sender_uid == uid()
        && request.resource.data.created_at is string
        && request.resource.data.sender_name is string
        && request.resource.data.event_id == eventId;

      allow delete: if
        canEditEvent(eventId)
        && (
          resource.data.sender_uid == uid()
          || isEventHost(eventId)
        );

      allow update: if false;
    }

    // ── Profiles ──────────────────────────────────────────────────────────────

    match /profiles/{profileId} {
      function profileMemberCanEdit() {
        return exists(/databases/$(database)/documents/profiles/$(profileId)/members/$(uid()))
          && get(/databases/$(database)/documents/profiles/$(profileId)/members/$(uid())).data.role in ['owner', 'admin', 'editor'];
      }

      allow read: if
        // Use get() so missing fields don't throw null-value errors in rule evaluation.
        resource.data.get('isPublic', false) == true
        || isProfileMember(profileId)
        // Profile owners can always read their own profiles.
        // This also makes list queries scoped by owner_uid work correctly,
        // because Firestore can statically verify owner_uid == auth.uid from the query.
        || (isAuthed() && resource.data.get('owner_uid', '') == uid());

      allow create: if
        isAuthed()
        && request.resource.data.keys().hasAll(['owner_uid'])
        && request.resource.data.owner_uid == uid();

      // Admins/editors can edit profile fields but CANNOT change `owner_uid`.
      // Letting them change owner means they could escalate to owner and
      // then mutate billing (plans are owner-only via setPlan callable).
      // Only the current owner can transfer ownership.
      allow update: if
        isAuthed()
        && (
          (resource.data.owner_uid == uid())
          || (profileMemberCanEdit()
              && request.resource.data.owner_uid == resource.data.owner_uid)
        );

      allow delete: if
        isAuthed()
        && resource.data.owner_uid == uid();
    }

    // Collection-group rule for `members` — needed so
    // `collectionGroup('members').where('user_uid', '==', uid)` (in
    // fetchProfiles) can be statically matched against the rule constraint.
    // Single allow clause keyed on resource.data.user_uid so the analyzer
    // recognizes the query/rule pair.
    match /{path=**}/members/{memberUid} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_uid;
    }

    match /profiles/{profileId}/members/{memberUid} {
      function profOwnerUid() {
        return exists(/databases/$(database)/documents/profiles/$(profileId))
          ? get(/databases/$(database)/documents/profiles/$(profileId)).data.owner_uid
          : null;
      }

      function requesterCanManageMembers() {
        return isAuthed() && (
          uid() == profOwnerUid()
          || isProfileAdmin(profileId)
        );
      }

      // Profile IDs are always "{ownerUid}__{roleSlot}" — verify ownership without a get().
      function profileBelongsToRequester() {
        return isAuthed()
          && uid() == memberUid
          && profileId.matches(uid() + '__.*');
      }

      allow read: if isAuthed() && uid() == memberUid;
      allow read: if isAuthed() && isProfileMember(profileId);
      allow read: if isAuthed() && uid() == profOwnerUid();

      allow update, delete: if requesterCanManageMembers();

      allow create: if
        requesterCanManageMembers()
        // Owner bootstrapping their own member doc (no profile get() needed).
        || (profileBelongsToRequester()
            && request.resource.data.user_uid == uid()
            && request.resource.data.role == 'owner')
        // Self-claim: invitee can create their own member doc when a matching invite exists.
        || (isAuthed()
            && uid() == memberUid
            && request.resource.data.user_uid == uid()
            && request.resource.data.role in ['admin', 'editor']
            && exists(/databases/$(database)/documents/profileInvites/$(profileId + '_' + request.auth.token.email.lower())));
    }

    // ── Profile admin invites ─────────────────────────────────────────────────

    match /profileInvites/{inviteId} {
      // Multiple `allow read` statements are OR'd. Splitting the inviter and
      // invitee cases into separate statements keeps each one independently
      // decidable for list queries — Firestore's static analyzer can match
      // the inviter's `where("profileId", "==", X)` against the first rule
      // and the invitee's `where("email", "==", Y)` against the second
      // without having to short-circuit a combined OR.
      allow read: if isAuthed() && isProfileAdmin(resource.data.profileId);
      allow read: if isAuthed() && request.auth.token.email.lower() == resource.data.email;

      allow create: if
        isAuthed()
        && isProfileAdmin(request.resource.data.profileId)
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;
      allow delete: if isAuthed() && isProfileAdmin(resource.data.profileId);
      allow delete: if isAuthed() && request.auth.token.email.lower() == resource.data.email;
      allow update: if false;
    }

    // ── Profile unavailability ────────────────────────────────────────────────

    match /profiles/{profileId}/unavailability/{docId} {
      allow read: if isProfileMember(profileId);
      allow write: if isProfileMember(profileId);
    }

    // ── Profile calendar items ─────────────────────────────────────────────────

    match /profiles/{profileId}/calendar_items/{itemId} {
      allow read, write: if isProfileMember(profileId);
    }

    // ── Profile team (contacts/crew — may not have Firebase accounts) ─────────

    match /profiles/{profileId}/team/{memberId} {
      allow read, write: if isProfileMember(profileId);
      allow delete: if isProfileAdmin(profileId);
    }

    // ── Profile templates ────────────────────────────────────────────────────
    //
    // Templates exist for surfaces tied to event creation (schedules,
    // settlements, deals, budgets, riders, contract terms). Performer
    // profiles can't create events at all, so they have no templates by
    // construction — enforce it here so a Free Artist (or any performer
    // profile) can't accumulate template docs that would never surface in
    // the UI.

    match /profiles/{profileId}/templates/{category}/items/{templateId} {
      allow read: if isProfileMember(profileId)
        && !isPerformerProfile(profileId);
      allow write, delete: if isProfileAdmin(profileId)
        && !isPerformerProfile(profileId);
    }

    // ── User notifications ────────────────────────────────────────────────────
    // Per-user fan-out: cloud functions write here, the user reads/marks/deletes.
    // create blocked so a client can't fabricate notifications for itself or others.

    match /users/{userId}/notifications/{notifId} {
      allow read, update, delete: if isAuthed() && uid() == userId;
      allow create: if false;
    }

    // ── User private data ────────────────────────────────────────────────────

    match /users/{userId}/{document=**} {
      allow read, write: if isAuthed() && uid() == userId;
    }

    // ── Public shares (settlement review, event snapshots, budget shares) ─────

    match /publicShares/{token} {
      allow read:   if isAuthed() && resource.data.ownerUid == uid();
      allow create: if isAuthed() && request.resource.data.ownerUid == uid();
      allow update, delete: if false;

      match /otp/{emailHash} {
        allow read, write: if false;
      }
    }

    // ── Collaborator invite tokens ────────────────────────────────────────────

    match /collaboratorInvites/{token} {
      allow read: if true;
      allow create: if isAuthed()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.get('passwordHash', null) == null;
      allow update: if
        request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.event_id == resource.data.event_id
        && request.resource.data.get('passwordHash', null) == resource.data.get('passwordHash', null);
    }

    match /collaboratorWrites/{token} {
      allow read, write: if true;
    }

    // ── Invitation codes ──────────────────────────────────────────────────────
    match /invitationCodes/{code} {
      allow read: if true;
      allow update: if isAuthed()
        && resource.data.createdByUid == uid()
        && request.resource.data.status == "revoked"
        && resource.data.status == "active";
      allow create, delete: if false;
    }

    // ── Admin collection ──────────────────────────────────────────────────────
    match /admins/{adminUid} {
      allow read: if isAuthed()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }

    // ── Admin alerts (spam review queue, future moderation surfaces) ─────────
    // Server-only writes (via callable). Reads gated to admins.
    match /adminAlerts/{alertId} {
      allow read: if isAuthed()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }

    // ── GDPR audit log ───────────────────────────────────────────────────────
    // Server-only writes via writeAudit(). Reads gated to admins so a data-
    // subject-access-request can be answered by an admin, but the log isn't
    // exposed to regular users (would itself be a privacy hole).
    match /auditLog/{logId} {
      allow read: if isAuthed()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }

    // ── Spam flags (per-performer audit trail) ───────────────────────────────
    // Server-only — `flagSenderAsSpam` writes through Admin SDK. Reads gated
    // to admins so an abusive performer can't see their own flag history.
    match /profiles/{profileId}/spamFlags/{flagId} {
      allow read: if isAuthed()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }

    // ── Plans ────────────────────────────────────────────────────────────────
    //
    // One doc per profile (id = profileId). Source of truth for tier gating
    // (free_operator | operator_pro | free_artist | artist_pro). Read by any
    // profile member so they can see "you're on Free Artist" in the billing
    // portal. Writes are server-only via the `setPlan` callable so plan
    // changes propagate immediately without a JWT round-trip — no custom
    // claim, no staleness window on downgrade.
    //
    // Other rules `get()` this doc directly when gating Pro-only surfaces.
    // Firestore caches identical paths within one request, so list queries
    // pay one read per unique plan referenced regardless of how many docs
    // evaluate the same rule path.

    match /plans/{profileId} {
      allow read: if isProfileMember(profileId);
      allow write: if false;
    }

    // ── OTP codes ─────────────────────────────────────────────────────────────
    match /otpCodes/{id} {
      allow read, write: if false;
    }

    // ── Booking requests ──────────────────────────────────────────────────────
    //
    // Free Artist constraint (PDF: "Send booking requests to venues already in
    // the system"): when an authenticated user creates an inbound request, the
    // `target_profile_id` must point to an existing profile. Out-of-network
    // outbound is reserved for the Artist Pro AI agent (not yet implemented).
    // Unauthenticated submissions (public booking widget) keep the looser
    // legacy validation because they don't have a plan to check against.

    function targetIsInNetwork() {
      let pid = request.resource.data.get('target_profile_id', '');
      return pid is string
        && pid != ''
        && exists(/databases/$(database)/documents/profiles/$(pid));
    }

    match /inboundBookingRequests/{id} {
      allow create: if
        request.resource.data.owner_uid is string
        && request.resource.data.owner_uid.size() > 0
        && request.resource.data.created_at is string
        && (
          // Unauthenticated/public path — legacy permissive validation.
          !isAuthed()
          // Authenticated path — must target an in-network profile.
          || targetIsInNetwork()
        );
      // Triple-path access:
      //   1. owner_uid — legacy fallback during backfill (target venue's owner).
      //   2. target_profile_id ∈ profileIds claim — admin/member of the venue
      //      receiving the request (claim populated by
      //      `onProfileMemberClaimsSync`, capped at 16 ids).
      //   3. sender_user_uid — performer who SENT the offer (Flow B). Lets
      //      them read/cancel their own outgoing requests on the Sent
      //      Requests page even though they don't own the target profile.
      allow read, update: if
        isAuthed()
        && (
          uid() == resource.data.get('owner_uid', '')
          || resource.data.get('target_profile_id', '') in request.auth.token.get('profileIds', [])
          || uid() == resource.data.get('sender_user_uid', '')
        );
    }

    // Legacy — read-only for any migration
    match /publicBookingRequests/{id} {
      allow create: if true;
      allow read, update: if isAuthed();
    }

    // ── Audience RSVPs ────────────────────────────────────────────────────────
    // Anonymous public-event viewers can submit. Reads stay closed until the
    // Audience CRM page lands and gates them on event host/access.

    match /audience_rsvps/{rsvpId} {
      allow create: if
        request.resource.data.keys().hasAll(['eventId', 'name', 'email', 'createdAt'])
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.email is string;
      allow read, update, delete: if false;
    }
  }
}
