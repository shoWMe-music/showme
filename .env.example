# Copy to `.env.local` only when you need overrides.
# `npm run dev` with no Firebase vars uses the emulator demo config and connects to localhost emulators (same as firebase.json ports).
# Full stack: `npm run dev:local` or `./scripts/dev-local.sh` (emulators + Vite + Functions watch).

# --- Firebase web (production / staging) ---
# Set all six when you want the real project in dev (and unset VITE_USE_FIREBASE_EMULATORS unless you still want emulators):
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# --- Optional: force emulator wiring / project id (otherwise implicit in dev when prod vars are unset) ---
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_PROJECT_ID=showme-local
# Optional overrides (defaults match firebase.json):
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
# VITE_FIRESTORE_EMULATOR_PORT=8090
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# VITE_STORAGE_EMULATOR_HOST=127.0.0.1
# VITE_STORAGE_EMULATOR_PORT=9199
# VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
# VITE_FUNCTIONS_EMULATOR_PORT=5001

# --- Local seed (`npm run seed:workspace`; also runs after emulators start with `npm run dev:local` / `npm run dev:emulators`) ---
# Defaults: daniel.islandman@gmail.com / 123456, venue + performer (artist) profiles in `scripts/seed/defaults.ts`.
# SEED_EMAIL=
# SEED_PASSWORD=
# SEED_DISPLAY_NAME=
