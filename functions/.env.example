# Copy to `functions/.env` for the Functions emulator (Firebase CLI loads dotenv from this folder).
# For production, set the same variable in your deployment environment / Secret Manager.

# https://www.exchangerate-api.com/ — key used for `exchangeRate` and `supportedCurrencies` HTTPS functions
EXCHANGE_RATE_API_KEY=

# SMTP for transactional emails (password reset, OTP, invitations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=shoWMe <no-reply@showme.live>
