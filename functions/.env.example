# Copy to `functions/.env` for the Functions emulator (Firebase CLI loads dotenv from this folder).
# For production, set the same variable in your deployment environment / Secret Manager.

# https://www.exchangerate-api.com/ — key used for `exchangeRate` and `supportedCurrencies` HTTPS functions
EXCHANGE_RATE_API_KEY=

# Brevo (transactional emails: password reset, OTP, invitations, team-member messages)
# Get your API key at https://app.brevo.com/settings/keys/api
# In production, set via Firebase Secret Manager: firebase functions:secrets:set BREVO_API_KEY
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@showme-google.se
BREVO_FROM_NAME=shoWMe
