{
  "name": "@showme/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts",
    "./reference-settlement": "./src/reference-settlement.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "seed:e2e": "tsx --env-file-if-exists=.env src/seed-e2e.ts",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@showme/settlement": "workspace:*",
    "@showme/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "drizzle-zod": "^0.6.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.23.4",
    "vitest": "^2.1.9"
  }
}
