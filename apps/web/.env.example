# API base URL the generated api-client points at.
# Local dev (API from `pnpm --filter @showme/api dev`):
VITE_API_URL=http://localhost:8080
# Production: https://api.<your-domain>

# Firebase web config (from `firebase apps:sdkconfig WEB <appId>`). Client config, non-secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E2E / local only: when set, the web app points Firebase Auth at the local
# emulator instead of a real project (see src/auth/firebase.ts). Leave BLANK in
# production. Example for the emulator on default port:
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR_HOST=
