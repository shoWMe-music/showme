# Production build config, baked into the client bundle by Vite. Everything here is
# PUBLIC by design — Firebase web config is not a secret (access is enforced by Auth
# + the API's authorization layer, never by hiding these values).

# The API origin. The load balancer in infra/ is DNS-wired and its managed
# certificate is ACTIVE, so the custom domain is the real origin now — the run.app
# URL it used to point at bypassed a load balancer that was being paid for and not
# used. europe-north2 has no Cloud Run domain mappings (HTTP 501), which is why the
# load balancer exists at all. The API's CORS_ALLOWED_ORIGINS must list this app's
# origin or every call is blocked.
VITE_API_URL=https://api.showme.music

# SSE service (apps/stream), live since 2026-09-21. One authenticated GET /stream per
# user, held open; frames only invalidate TanStack caches, so live updates and a cold
# load share one read path.
#
# SAME HOST AS THE API, routed by path. The load balancer's forwarding rule is already
# paid for (the "minimum" SKU covers five rules), so a second backend behind it costs
# nothing but per-GB processing — whereas a stream.showme.music subdomain would have
# needed its own load balancer at ~$19/mo for a service that fits on this one. The
# client appends `/stream`, which the URL map routes to the stream backend while every
# other path stays with the API. Verified end to end: a connection held 95s through the
# load balancer, past the 30s and 60s timeouts that would have severed it.
VITE_STREAM_URL=https://api.showme.music

# Firebase Auth lives on music-showme (see docs/handoff-2026-08-23-marketing-and-hosting.md
# for the project/account map). Must stay BLANK for the emulator host, or a production
# build would try to talk to a local emulator.
VITE_FIREBASE_API_KEY=AIzaSyD2ZiVXPw9_IxbBe4GKAQ0sNqU2DyW2oqI
VITE_FIREBASE_AUTH_DOMAIN=music-showme.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=music-showme
VITE_FIREBASE_STORAGE_BUCKET=music-showme.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1098805934399
VITE_FIREBASE_APP_ID=1:1098805934399:web:46ec20c1d8ae368daebb8a
VITE_FIREBASE_AUTH_EMULATOR_HOST=
