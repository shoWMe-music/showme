# shoWMe API environment. Copy to `.env` for local dev; in production these come
# from Secret Manager. Only DATABASE_URL is required to boot.

# --- Required ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/showme

# --- Server (optional; defaults shown) ---
# PORT=8080
# HOST=0.0.0.0

# --- Firebase Auth (needed to verify tokens; optional at boot) ---
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT=            # service-account JSON, or its base64

# --- Off-platform share OTP→JWT (decisions #6) ---
# SHARE_JWT_SECRET=

# --- ClickUp CRM lead capture (marketing contact form) ---
# When both are set, /public/leads forwards leads to this ClickUp list as tasks.
# When unset, leads are logged instead (see apps/api/src/lib/clickup.ts).
# Personal API token: ClickUp → Settings → Apps → API Token (starts with "pk_").
# CLICKUP_API_TOKEN=
# "Website Leads" list in the CRM space:
CLICKUP_LEADS_LIST_ID=901524890050
# Comma-separated origins allowed to POST /public/leads (the marketing site).
# Defaults to the local dev origins (localhost:5173,4173) when unset. In prod set
# this to the marketing domain, e.g. https://showme.music
# LEADS_ALLOWED_ORIGINS=https://showme.music

# --- Brevo transactional email (invites, share OTPs, event notices) ---
# Real sending needs BOTH; when either is missing, messages are logged instead
# (see apps/api/src/lib/email.ts). The sender address must be a verified sender
# on a Brevo-authenticated domain, or Brevo rejects the send.
# BREVO_API_KEY=
# BREVO_SENDER=no-reply@showme.music

# --- Public origin of the web app (links inside those emails) ---
# Every link in a transactional email is built from this (no domain is ever
# hardcoded in a template). Defaults to the local web dev server
# (http://localhost:5174) when unset. In prod set this to the app's host.
# PUBLIC_APP_BASE_URL=https://showme-app.web.app
