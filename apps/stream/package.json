    "fastify": "^5.2.0",
    "firebase-admin": "^13.0.2",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.4",
    "vitest": "^2.1.9"
  }
}
