{
  "name": "@showme/stream",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node esbuild.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@showme/auth": "workspace:*",
    "@showme/db": "workspace:*",
    "@showme/shared": "workspace:*",
