# Production build config (baked into the client bundle by Vite).
# The contact form POSTs leads here; the API forwards them to ClickUp server-side.
#
# INTERIM: europe-north2 doesn't support Cloud Run domain mappings (HTTP 501), so
# api.showme.music can't be attached without an external HTTPS load balancer (TODO:
# provision that in infra/*.tf, then switch this back to https://api.showme.music/...).
# Until then, point straight at the service's run.app origin (CORS allows the
# marketing origins). Leave empty to disable lead submission (form still shows success).
VITE_LEAD_ENDPOINT=https://showme-api-680839076083.europe-north2.run.app/api/v1/public/leads

# The shared availability page (availability.html) reads the API's public routes.
# Same interim origin as the lead endpoint above — verified 2026-08-26 that the
# deployed API returns access-control-allow-origin for https://www.showme.music
# and https://showme.music, so no CORS change is needed to ship this page.
VITE_PUBLIC_API_URL=https://showme-api-680839076083.europe-north2.run.app/api/v1

# Where the web app lives. The public profile page links to it from the industry
# lane ("Sign in for documents") — a venue's rider is behind a login, and the page
# says so with a link rather than a dead button. Empty hides that link entirely
# (STYLE-GUIDE §7: no dead affordances).
VITE_APP_URL=https://showme-app.web.app
