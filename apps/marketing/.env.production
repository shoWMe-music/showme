# Production build config (baked into the client bundle by Vite).
# The contact form POSTs leads here; the API forwards them to ClickUp server-side.
# This must be the PUBLIC API origin once apps/api is deployed and api.showme.music
# is mapped to it. Leave empty to disable lead submission (form still shows success).
VITE_LEAD_ENDPOINT=https://api.showme.music/api/v1/public/leads
