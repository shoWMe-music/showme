# URL of the server-side lead endpoint. The marketing contact form POSTs
# {name,email,message} here; the API forwards it to ClickUp CRM as a task.
# Local dev (API from `pnpm --filter @showme/api dev`, default port 8080):
VITE_LEAD_ENDPOINT=http://localhost:8080/api/v1/public/leads
# Production: https://api.<your-domain>/api/v1/public/leads

# Google Analytics 4 Measurement ID (format G-XXXXXXXXXX). Analytics is
# consent-gated (Google Consent Mode v2): GA only loads after the visitor
# accepts analytics cookies via the on-site banner. Leave unset for local dev /
# previews — no analytics loads, but the consent banner still works.
VITE_GA_MEASUREMENT_ID=
